package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aconfig_declarations {
    name: "powerhal_flags-aconfig",
    container: "vendor",
    package: "powerhal.flags",
    exportable: true,
    srcs: ["flags.aconfig"],
}

cc_aconfig_library {
    name: "powerhal_flags-aconfig-cc",
    aconfig_declarations: "powerhal_flags-aconfig",
    vendor: true,
}

cc_prebuilt_library {
    name: "libdisppower-pixel",
    owner: "google",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "libdisppower-pixel.so",
            ],
            shared_libs: [
                "libbase",
                "libcutils",
                "liblog",
                "libperfmgr",
                "libutils",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

// Deprecated, do not use
// Use pixel-power-ext for vendor extension
cc_library_headers {
    name: "pixel_power_headers",
    vendor: true,
    export_include_dirs: ["hidl"],
}

cc_prebuilt_binary {
    name: "android.hardware.power-service.pixel-libperfmgr",
    owner: "google",
    target: {
        android_arm64: {
            srcs: [
                "android.hardware.power-service.pixel-libperfmgr",
            ],
            shared_libs: [
                "android.hardware.thermal@2.0",
                "android.hardware.thermal-V1-ndk",
                "libbase",
                "libcutils",
                "liblog",
                "libutils",
                "libbinder_ndk",
                "libdisppower-pixel",
                "libperfmgr",
                "libprocessgroup",
                "pixel-power-ext-V1-ndk",
                "android.frameworks.stats-V2-ndk",
                "android.hardware.common.fmq-V1-ndk",
                "libfmq",
            ],
        },
    },
    compile_multilib: "64",
    strip: {
        none: true,
    },
    prefer: true,
    relative_install_path: "hw",
    init_rc: ["aidl/android.hardware.power-service.pixel-libperfmgr.rc"],
    vintf_fragments: ["aidl/android.hardware.power-service.pixel.xml"],
    soc_specific: true,
}

cc_prebuilt_binary {
    name: "sendhint",
    owner: "google",
    target: {
        android_arm64: {
            srcs: [
                "sendhint",
            ],
            shared_libs: [
                "libbase",
                "libcutils",
                "liblog",
                "libutils",
                "libbinder_ndk",
                "pixel-power-ext-V1-ndk",
            ],
        },
    },
    compile_multilib: "64",
    strip: {
        none: true,
    },
    prefer: true,
    soc_specific: true,
}
